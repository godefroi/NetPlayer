# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy solution and project files
COPY ["SongServer.Models/SongServer.Models.csproj", "SongServer.Models/"]
COPY ["SongServer.Player/SongServer.Player.csproj", "SongServer.Player/"]

# Restore dependencies
RUN dotnet restore "SongServer.Player/SongServer.Player.csproj"

# Copy the rest of the source code
COPY ["SongServer.Models/", "SongServer.Models/"]
COPY ["SongServer.Player/", "SongServer.Player/"]

# Build the application
RUN dotnet build "SongServer.Player/SongServer.Player.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "SongServer.Player/SongServer.Player.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app

# Install runtime dependencies for audio processing (LibVLC)
# RUN apt-get update && apt-get install -y \
# #    vlc-plugin-base \
# #    vlc-plugin-video-output \
# #    libvlc5 \
# 	libvlc-dev vlc \
# 	&& rm -rf /var/lib/apt/lists/*

COPY --from=publish /app/publish .

# Default port for ASP.NET Core
EXPOSE 80
EXPOSE 443

# Health check
#HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#    CMD curl -f http://localhost/health || exit 1

# Run the application
ENTRYPOINT ["dotnet", "SongServer.Player.dll"]
